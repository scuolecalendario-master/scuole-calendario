# Copia in .env.local e compila con i valori del progetto Supabase
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chiave segreta (Project Settings → API Keys → Secret keys). SOLO lato server:
# serve al master per reimpostare le password. Non usare il prefisso NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Notifiche push (web push, niente email). Genera con: npx web-push generate-vapid-keys
# La pubblica può stare nel browser; la privata SOLO sul server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuo-indirizzo@example.com

# Segreto del cron dei backup (vercel.json): stringa casuale lunga
CRON_SECRET=
